   "source": "def fg_counts(records, allowed=None):\n    c = Counter()\n    for r in records:\n        for l in (r.get('fine_grained_label') or []):\n            if allowed is None or l in allowed:\n                c[l] += 1\n    return c\n\nactive = set(FINE_GRAINED_LABELS)\noverall = {n: fg_counts(recs, active) for n, recs in splits.items() if recs}\nby_hateful = {n: fg_counts([r for r in recs if r.get('label') == 'Hateful'], active) for n, recs in splits.items() if recs}\nby_nonhate = {n: fg_counts([r for r in recs if r.get('label') == 'Not Hateful'], active) for n, recs in splits.items() if recs}\n\nprint('A2 fine-grained vocab (', len(active), 'classes):', sorted(active))\nprint('train — overall:', dict(overall.get('train', {})))\nprint('train — among Hateful:', dict(by_hateful.get('train', {})))\nprint('train — among Not Hateful:', dict(by_nonhate.get('train', {})))"
