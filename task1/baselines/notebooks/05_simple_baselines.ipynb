   "source": "# Simple baselines + format checker + scorer\n\nA quick walk-through of the **majority** and **random** baselines for both subtasks, followed by the **format checker** and the **scorer**. These are the fastest way to produce a valid submission file and to verify the end-to-end pipeline.\n\n**Prerequisite:** `python data/download_data.py` has been run."
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "f27d5ea0",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys, subprocess\n",
    "from pathlib import Path\n",
    "\n",
    "TASK1 = Path.cwd().resolve()\n",
    "while TASK1.name != 'task1' and TASK1.parent != TASK1:\n",
    "    TASK1 = TASK1.parent\n",
    "DATA = TASK1 / 'data' / 'splits'\n",
    "PRED = TASK1 / 'predictions'\n",
    "PRED.mkdir(exist_ok=True)\n",
    "\n",
    "def sh(*args):\n",
    "    print('$', ' '.join(args))\n",
    "    print(subprocess.check_output([sys.executable, *args], text=True, cwd=TASK1))"
   ]
  },
